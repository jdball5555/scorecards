rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything except templates: any signed-in user can read and write
    // (same as before). Templates are left out here because Firestore allows
    // a request if ANY rule allows it, so this catch-all would otherwise
    // override the template rule below.
    match /{collection}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && collection != 'scorecard_templates';
    }

    // Custom templates are a premium beta feature. premiumBeta is a sign-in
    // claim that only the server sets (Axis Optic → functions/optic.js), so
    // it can't be faked from the app or the browser.
    match /scorecard_templates/{templateId} {
      allow read: if request.auth != null;
      allow create: if request.auth.token.premiumBeta == true
                    && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth.token.premiumBeta == true
                    && resource.data.creatorId == request.auth.uid
                    && request.resource.data.creatorId == request.auth.uid;
      // People can always delete their own templates, premium or not.
      allow delete: if request.auth != null
                    && resource.data.creatorId == request.auth.uid;
    }
  }
}
