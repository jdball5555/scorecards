rules_version = '2';

// Who can read and write what. Cloud Functions use the Admin SDK and aren't
// limited by these rules. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/game_groups/$(groupId);
    }

    // Uses the group as it was before this request (in a batch, before any
    // of its writes).
    function inGroup(groupId, uid) {
      return groupId is string
          && exists(groupPath(groupId))
          && uid in get(groupPath(groupId)).data.members;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function shortText(s, max) {
      return s is string && s.size() <= max;
    }

    // ---------------------------------------------------------------------
    // Profiles. Group members show each other's name and email, so a signed-in
    // user can read a profile by its id, but can't list or search them (find
    // by email goes through the findUserByEmail Cloud Function instead).
    // premiumBeta is a copy of a sign-in claim only the server sets.
    match /users/{uid} {
      allow get: if signedIn();
      allow create: if signedIn() && me() == uid
                    && !('premiumBeta' in request.resource.data)
                    && (!('email' in request.resource.data)
                        || request.resource.data.email == request.auth.token.email);
      allow update: if signedIn() && me() == uid
                    && !changed().hasAny(['premiumBeta'])
                    && (!changed().hasAny(['email'])
                        || request.resource.data.email == request.auth.token.email);

      // In-app mail: notices and group invites.
      match /mail/{mailId} {
        allow read: if signedIn() && me() == uid;
        // You can mark your own mail read, accept or decline an invite, or
        // delete it, but not change what it says.
        allow update: if signedIn() && me() == uid
                      && changed().hasOnly(['status']);
        allow delete: if signedIn() && me() == uid;

        // Other people's mail: only group notices and invites, and only from
        // someone in the group (game results are sent by the server).
        allow create: if signedIn()
                      && request.resource.data.senderUid == me()
                      && inGroup(request.resource.data.groupId, me())
                      && (isNotice() || isInvite());

        function isNotice() {
          return request.resource.data.type == 'system_notice'
              && shortText(request.resource.data.message, 500)
              && inGroup(request.resource.data.groupId, uid);
        }

        function isInvite() {
          return request.resource.data.type == 'invite_received'
              && request.resource.data.status == 'pending'
              && request.resource.data.targetUid == uid
              && shortText(request.resource.data.groupName, 200);
        }
      }
    }

    // ---------------------------------------------------------------------
    // Groups. Only members can see a group. Joining needs an invite: a
    // pending invite in your mail from a member, or an unused invite link.
    match /game_groups/{groupId} {
      function members() {
        return resource.data.members;
      }

      function isMember() {
        return signedIn() && me() in members();
      }

      function isOwner() {
        return signedIn() && resource.data.owner == me();
      }

      allow read: if isMember();

      allow create: if signedIn()
                    && request.resource.data.owner == me()
                    && request.resource.data.members == [me()];

      allow update: if (isMember() && memberUpdate()) || joining();

      allow delete: if isOwner();

      // Members manage the group's players and settings. Only the owner can
      // hand over ownership or remove someone else; anyone can leave.
      function memberUpdate() {
        let newMembers = request.resource.data.members;
        return !changed().hasAny(['joinedVia'])
            && (!changed().hasAny(['owner'])
                || (isOwner() && request.resource.data.owner in members()))
            && (!changed().hasAny(['members'])
                || (members().toSet().hasAll(newMembers)
                    && (isOwner()
                        || newMembers.toSet()
                             == members().toSet().difference([me()].toSet()))));
      }

      // Adding yourself to members, in the same batch as using up an invite.
      function joining() {
        let via = request.resource.data.joinedVia;
        return signedIn()
            && !(me() in members())
            && changed().hasOnly(['members', 'joinedVia'])
            && request.resource.data.members.toSet()
                 == members().toSet().union([me()].toSet())
            && via is map
            && ((via.type == 'mail' && acceptsMailInvite(via.id))
                || (via.type == 'link' && claimsInviteLink(via.id)));
      }

      function acceptsMailInvite(inviteId) {
        let path = /databases/$(database)/documents/users/$(me())/mail/$(inviteId);
        let invite = get(path).data;
        return inviteId is string
            && invite.type == 'invite_received'
            && invite.groupId == groupId
            && invite.status == 'pending'
            && getAfter(path).data.status == 'accepted';
      }

      function claimsInviteLink(token) {
        let path = /databases/$(database)/documents/player_invites/$(token);
        return token is string
            && get(path).data.groupId == groupId
            && get(path).data.usedBy == null
            && getAfter(path).data.usedBy == me();
      }
    }

    // ---------------------------------------------------------------------
    // Scorecards belong to a person (ownerType 'person', ownerId = their uid)
    // or a group (ownerType 'group', ownerId = the group's id).
    match /scorecards/{scorecardId} {
      function canUse(data) {
        return signedIn()
            && ((data.ownerType == 'person' && data.ownerId == me())
                || (data.ownerType == 'group' && inGroup(data.ownerId, me())));
      }

      allow read: if canUse(resource.data);
      allow create: if canUse(request.resource.data);
      // Can't be moved to someone else or a group you're not in.
      allow update: if canUse(resource.data) && canUse(request.resource.data);
      allow delete: if canUse(resource.data);
    }

    // ---------------------------------------------------------------------
    // Custom templates are a premium beta feature and private to whoever
    // made them. premiumBeta is a sign-in claim that only the server sets
    // (Axis Optic -> functions/optic.js), so it can't be faked from the app.
    match /scorecard_templates/{templateId} {
      allow read: if signedIn() && resource.data.creatorId == me();
      allow create: if request.auth.token.premiumBeta == true
                    && request.resource.data.creatorId == me();
      allow update: if request.auth.token.premiumBeta == true
                    && resource.data.creatorId == me()
                    && request.resource.data.creatorId == me();
      // People can always delete their own templates, premium or not.
      allow delete: if signedIn() && resource.data.creatorId == me();
    }

    // ---------------------------------------------------------------------
    // "Invite with a link". The document id is the random token in the link,
    // so having the link is what lets you open it.
    match /player_invites/{token} {
      function isGroupMember() {
        return inGroup(resource.data.groupId, me());
      }

      allow get: if signedIn();
      allow list: if signedIn() && isGroupMember();

      allow create: if signedIn()
                    && request.resource.data.createdBy == me()
                    && request.resource.data.usedBy == null
                    && inGroup(request.resource.data.groupId, me());

      // Members keep the names on it current; whoever opens the link uses
      // it up, once.
      allow update: if signedIn()
                    && ((isGroupMember()
                         && changed().hasOnly(['localPlayerName', 'groupName']))
                        || (resource.data.usedBy == null
                            && request.resource.data.usedBy == me()
                            && changed().hasOnly(['usedBy', 'usedAt'])));

      allow delete: if signedIn() && isGroupMember();
    }

    // ---------------------------------------------------------------------
    // Feedback copies (the real thing goes to Axis Optic). Write-only.
    match /feedback/{feedbackId} {
      allow create: if signedIn()
                    && request.resource.data.uid == me()
                    && shortText(request.resource.data.text, 20000);
    }
  }
}
